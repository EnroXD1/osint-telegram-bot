# Токен от @BotFather. Храните только у себя в .env.
BOT_TOKEN=
# Необязательно: ID разрешённых пользователей через запятую.
# Пустое значение разрешает всем писать боту в личные сообщения.
ALLOWED_USER_IDS=
# Необязательно: API-ключ DaData для сведений о юридических лицах.
DADATA_API_TOKEN=
# Необязательно: токен GitHub для увеличения квоты открытого REST API.
GITHUB_API_TOKEN=
DEFAULT_PHONE_REGION=RU
REQUESTS_PER_MINUTE=10
HTTP_TIMEOUT_SECONDS=10
